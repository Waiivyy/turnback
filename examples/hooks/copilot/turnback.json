{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "turnback hook start --agent copilot || exit 0",
        "powershell": "turnback hook start --agent copilot; exit 0",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "turnback hook end || exit 0",
        "powershell": "turnback hook end; exit 0",
        "timeoutSec": 30
      }
    ]
  }
}
